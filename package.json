{
  "name": "softie-webgpu",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/boss.test.js tests/face-motion.test.js tests/i18n.test.js tests/pet.test.js tests/physics.test.js tests/rage-meter.test.js tests/slime.test.js tests/sound.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:boss": "node tests/boss-browser.mjs",
    "desktop": "npm run build && electron electron/main.cjs",
    "package:arch": "npm run build && makepkg --syncdeps --force"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "vite": "^8.2.2"
  }
}
